<odoo>
    <template id="external_layout_striped_custom" inherit_id="web.external_layout_striped">

        <xpath expr="//div[@t-attf-class and contains(@t-attf-class, 'header')]" position="replace">

            <div t-attf-class="o_company_#{company.id}_layout header">
                <div class="row align-items-center w-100">

                    <!-- Columna 1: Logo + tagline -->
                    <div class="col-5">
                        <img t-if="company.logo"
                             class="o_company_logo_big"
                             t-att-src="image_data_uri(company.logo)"
                             alt="Logo"/>

                        <div t-if="company.report_header"
                             t-field="company.report_header"
                             class="o_company_tagline fw-bold mt-2"/>
                    </div>

                    <!-- Columna 2: Dirección -->
                    <div class="col-5" name="company_address">
                        <ul class="list-unstyled mb-0" name="company_address_list">
                            <li t-if="company.is_company_details_empty">
                                <span t-field="company.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                            </li>
                            <li t-else="">
                                <span t-field="company.company_details"/>
                            </li>
                            <li t-if="forced_vat">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                <span t-esc="forced_vat"/>
                            </li>
                        </ul>
                    </div>

                    <!-- Columna 3: Logos legales -->
                    <div class="col-2 text-end">
                        <img src="/cfi_custom/static/src/lssi.jpg"
                             style="max-width: 100%; height: auto; margin-bottom: 10px;"
                             alt="LSSI"/>
                        <br/>
                        <img src="/cfi_custom/static/src/rgpd.jpg"
                             style="max-width: 100%; height: auto;"
                             alt="RGPD"/>
                    </div>

                </div>
            </div>

        </xpath>

    </template>
</odoo>
